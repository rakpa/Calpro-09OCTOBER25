# frozen_string_literal: true

require 'fileutils'

default_platform(:ios)

platform :ios do
  desc 'Sign with imported .p12 or create a new Distribution cert, then upload TestFlight'
  lane :beta do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch('ASC_KEY_ID').strip,
      issuer_id: ENV.fetch('ASC_ISSUER_ID').strip,
      key_filepath: ENV.fetch('API_KEY_PATH'),
      duration: 1200,
      in_house: false
    )

    team_id = ENV.fetch('APPLE_TEAM_ID').strip
    bundle_id = ENV.fetch('BUNDLE_ID', 'www.calpro.app')

    # setup_ci creates fastlane_tmp_keychain; use its password (usually empty).
    keychain_path = ENV['KEYCHAIN_PATH'] || File.expand_path('~/Library/Keychains/fastlane_tmp_keychain-db')
    keychain_password = ENV['MATCH_KEYCHAIN_PASSWORD'] || ENV['KEYCHAIN_PASSWORD'] || ''

    project_root = File.expand_path('..', __dir__)
    signing_dir = File.join(project_root, 'build/ios/signing')
    FileUtils.mkdir_p(signing_dir)

    p12_path = ENV['BUILD_CERTIFICATE_PATH']
    p12_password = ENV['P12_PASSWORD']
    export_password = (p12_password.nil? || p12_password.empty?) ? 'CalcProTempExport!' : p12_password

    create_or_export_distribution_cert = lambda do |force_create|
      begin
        cert(
          api_key: api_key,
          development: false,
          force: force_create,
          keychain_path: keychain_path,
          keychain_password: keychain_password
        )
      rescue StandardError => e
        UI.user_error!(
          "Could not create/install a Distribution certificate.\n" \
          "If at the certificate limit, revoke an unused Apple Distribution cert at:\n" \
          "https://developer.apple.com/account/resources/certificates/list\n" \
          "Original error: #{e.message}"
        )
      end

      export_path = File.join(signing_dir, 'distribution.p12')
      sh(
        'security', 'export',
        '-k', keychain_path,
        '-t', 'identities',
        '-f', 'pkcs12',
        '-P', export_password,
        '-o', export_path
      )

      File.write(
        File.join(signing_dir, 'README.txt'),
        <<~TXT
          Distribution certificate created by CI.

          1. Download Actions artifact "calcpro-distribution-p12"
          2. Windows PowerShell:
             [Convert]::ToBase64String([IO.File]::ReadAllBytes("distribution.p12")) | Set-Clipboard
          3. GitHub secret BUILD_CERTIFICATE_BASE64 = paste
          4. GitHub secret P12_PASSWORD = #{export_password}
        TXT
      )
      UI.success("Exported #{export_path}")
    end

    if p12_path && File.exist?(p12_path) && !File.zero?(p12_path) && p12_password && !p12_password.empty?
      UI.message('Importing existing Distribution .p12 from GitHub secrets / prior artifact')
      import_certificate(
        certificate_path: p12_path,
        certificate_password: p12_password,
        keychain_path: keychain_path,
        keychain_password: keychain_password
      )
      # Keep a copy under build/ios/signing for the Actions artifact upload step.
      FileUtils.cp(p12_path, File.join(signing_dir, 'distribution.p12'))
    else
      UI.important('No BUILD_CERTIFICATE — creating/installing a Distribution certificate in CI')
      create_or_export_distribution_cert.call(false)
    end

    # setup_ci sets MATCH_READONLY=true which conflicts with sigh(force:). Override.
    ENV['MATCH_READONLY'] = 'false'
    ENV['SIGH_READONLY'] = 'false'

    if ENV['BUILD_PROVISION_PROFILE_PATH'] && File.exist?(ENV['BUILD_PROVISION_PROFILE_PATH'])
      install_provisioning_profile(path: ENV['BUILD_PROVISION_PROFILE_PATH'])
      profile_uuid = ENV['PROVISIONING_PROFILE_UUID']
      profile_name = ENV['PROVISIONING_PROFILE_NAME']
    else
      begin
        # force: recreate when App ID capabilities (e.g. App Groups) change.
        profile_uuid = sigh(
          api_key: api_key,
          app_identifier: bundle_id,
          adhoc: false,
          readonly: false,
          force: true
        )
      rescue StandardError => e
        # Restored .p12 may be revoked on the portal; create a fresh Distribution cert.
        if e.message.to_s.match?(/matching code signing identity|Could not find Bundle Identifier|No code signing/i)
          UI.important("sigh failed (#{e.message}) — creating a fresh Distribution certificate and retrying")
          create_or_export_distribution_cert.call(true)
          profile_uuid = sigh(
            api_key: api_key,
            app_identifier: bundle_id,
            adhoc: false,
            readonly: false,
            force: true
          )
        else
          raise e
        end
      end
      profile_name = ENV['SIGH_NAME']
    end

    update_code_signing_settings(
      use_automatic_signing: false,
      path: File.join(project_root, 'ios/Runner.xcodeproj'),
      team_id: team_id,
      targets: ['Runner'],
      bundle_identifier: bundle_id,
      code_sign_identity: 'iPhone Distribution',
      profile_uuid: profile_uuid,
      profile_name: profile_name
    )

    build_app(
      workspace: File.join(project_root, 'ios/Runner.xcworkspace'),
      scheme: 'Runner',
      configuration: 'Release',
      clean: false,
      export_method: 'app-store',
      output_directory: File.join(project_root, 'build/ios/ipa'),
      output_name: 'CalcPro.ipa',
      export_team_id: team_id,
      export_options: {
        method: 'app-store',
        signingStyle: 'manual',
        teamID: team_id,
        provisioningProfiles: {
          bundle_id => (profile_name || profile_uuid)
        }
      }
    )

    ipa_path = File.join(project_root, 'build/ios/ipa/CalcPro.ipa')
    UI.success("IPA ready at #{ipa_path}")

    # App Store Connect occasionally returns transient 500s during upload.
    attempts = 0
    begin
      attempts += 1
      upload_to_testflight(
        api_key: api_key,
        ipa: ipa_path,
        skip_waiting_for_build_processing: true,
        distribute_external: false
      )
    rescue StandardError => e
      if attempts < 3 && e.message.to_s.match?(/500|internal server error|Could not download\/upload/i)
        UI.important("TestFlight upload failed (attempt #{attempts}/3): #{e.message}")
        UI.important('Retrying in 60 seconds...')
        sleep 60
        retry
      end
      raise e
    end
  end
end
