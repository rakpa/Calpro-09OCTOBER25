# frozen_string_literal: true

default_platform(:ios)

platform :ios do
  desc 'Import existing Distribution .p12, sync App Store profile, archive, upload TestFlight'
  lane :beta do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch('ASC_KEY_ID').strip,
      issuer_id: ENV.fetch('ASC_ISSUER_ID').strip,
      key_filepath: ENV.fetch('API_KEY_PATH'),
      duration: 1200,
      in_house: false
    )

    team_id = ENV.fetch('APPLE_TEAM_ID').strip
    bundle_id = ENV.fetch('BUNDLE_ID', 'www.calpro.app')
    keychain_path = ENV['KEYCHAIN_PATH'] || File.expand_path('~/Library/Keychains/fastlane_tmp_keychain-db')
    keychain_password = ENV['KEYCHAIN_PASSWORD'] || 'fastlane_tmp'

    certificate_path = ENV.fetch('BUILD_CERTIFICATE_PATH')
    certificate_password = ENV.fetch('P12_PASSWORD')

    # Import the Distribution identity you already own (required — Apple account is at cert limit).
    import_certificate(
      certificate_path: certificate_path,
      certificate_password: certificate_password,
      keychain_path: keychain_path,
      keychain_password: keychain_password
    )

    if ENV['BUILD_PROVISION_PROFILE_PATH'] && File.exist?(ENV['BUILD_PROVISION_PROFILE_PATH'])
      install_provisioning_profile(path: ENV['BUILD_PROVISION_PROFILE_PATH'])
      profile_uuid = ENV['PROVISIONING_PROFILE_UUID']
      profile_name = ENV['PROVISIONING_PROFILE_NAME']
    else
      # Create/download an App Store profile for www.calpro.app using the imported cert.
      profile_uuid = sigh(
        api_key: api_key,
        app_identifier: bundle_id,
        adhoc: false,
        readonly: false,
        force: true,
        fail_on_name_taken: false
      )
      profile_name = ENV['SIGH_NAME']
    end

    update_code_signing_settings(
      use_automatic_signing: false,
      path: 'ios/Runner.xcodeproj',
      team_id: team_id,
      targets: ['Runner'],
      bundle_identifier: bundle_id,
      code_sign_identity: 'iPhone Distribution',
      profile_uuid: profile_uuid,
      profile_name: profile_name
    )

    build_app(
      workspace: 'ios/Runner.xcworkspace',
      scheme: 'Runner',
      configuration: 'Release',
      clean: false,
      export_method: 'app-store',
      output_directory: 'build/ios/ipa',
      output_name: 'CalcPro.ipa',
      export_team_id: team_id,
      export_options: {
        method: 'app-store',
        signingStyle: 'manual',
        teamID: team_id,
        provisioningProfiles: {
          bundle_id => (profile_name || profile_uuid)
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: 'build/ios/ipa/CalcPro.ipa',
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
